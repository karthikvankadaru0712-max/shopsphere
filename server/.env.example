# ShopSphere Server Environment Configuration Template
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-shopsphere-client.onrender.com

# MongoDB Atlas Database URL (replace with your free cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopsphere_db?retryWrites=true&w=majority

# Security Secrets (generate random 64-char strings for production)
JWT_SECRET=shopsphere_ultra_secure_jwt_secret_key_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=shopsphere_cookie_signing_secret_production
PASSWORD_RESET_SECRET=shopsphere_reset_token_secret_production

# Payment & Simulation
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=mock
AI_PROVIDER=rule-based
