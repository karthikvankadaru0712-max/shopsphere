# ShopSphere Server Environment Configuration Template
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere_db

# Security (use unique, randomly generated values outside local development)
JWT_SECRET=replace_with_a_random_jwt_secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_random_cookie_secret
PASSWORD_RESET_SECRET=replace_with_a_random_password_reset_secret

# Cloudinary (optional; leave blank when not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email
EMAIL_PROVIDER=mock
EMAIL_API_KEY=your_email_provider_api_key

# AI
AI_PROVIDER=rule-based
AI_API_KEY=your_ai_provider_api_key
